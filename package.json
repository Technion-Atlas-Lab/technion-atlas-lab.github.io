{
  "name": "atlas-lab-website",
  "private": true,
  "description": "Static website for ATLAS Lab, Technion",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "validate": "node tools/validate.js",
    "lint": "eslint --max-warnings 0 .",
    "build": "eleventy",
    "serve": "eleventy --serve",
    "linkcheck": "node tools/linkcheck.js",
    "test": "playwright test",
    "test:site": "playwright test -c playwright.site.config.js",
    "shots": "node tools/shots.js"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/cli": "^0.1.24",
    "@playwright/test": "^1.65.1",
    "eslint": "^10.15.0",
    "eslint-plugin-playwright": "^2.12.2",
    "globals": "^17.14.0",
    "js-yaml": "^4.3.2",
    "sharp": "^0.35.5"
  }
}
