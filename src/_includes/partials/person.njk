{#- Pieces the pages that show or name people share. #}

{#- A person's picture: their photo, or an avatar of their initials.
    `sizes` is how wide the picture is shown, so the browser fetches the right
    file. `alt` names a photo where no name is written beside it; elsewhere
    the picture is decoration, and so is the initials avatar always. #}
{%- macro avatar(person, sizes, alt="") -%}
{%- if person.picture -%}
<img class="avatar" src="{{ person.picture.src }}" srcset="{{ person.picture.srcset }}" sizes="{{ sizes }}" alt="{{ alt }}" width="{{ person.picture.size }}" height="{{ person.picture.size }}" loading="lazy">
{%- else -%}
<span class="avatar" aria-hidden="true">{{ person.initials }}</span>
{%- endif -%}
{%- endmacro -%}

{#- The people beside a Publication, a News item or a Student Project, by
    name, with commas between them. A current Member's name links to their
    Profile, except on that Profile itself: `onProfile` is the slug of the
    Member whose Profile shows the names. #}
{%- macro names(people, onProfile=null) -%}
{%- for person in people -%}
{%- if person.profile and person.profile != onProfile -%}
<a href="/people/{{ person.profile }}/">{{ person.name }}</a>
{%- else -%}
{{ person.name }}
{%- endif -%}
{%- if not loop.last %}, {% endif -%}
{%- endfor -%}
{%- endmacro -%}
