{#- A Student Project's card, shared by the Projects page and the Profile pages. #}

{#- `onProfile` is the slug of the Member whose Profile shows the card: there
    the Member is named without a link to the page the visitor is already on,
    and an Offered project says so, which Projects shows as a heading. #}
{%- macro studentProject(project, onProfile=null) -%}
<article class="student-project">
  <h3 class="student-project__title">{{ project.title }}</h3>
  {%- if project.completed %}
  <p class="student-project__status">Completed in {{ project.year }}</p>
  {%- elif onProfile %}
  <p class="student-project__status"><span class="badge">Offered</span></p>
  {%- endif %}
  {%- for paragraph in project.description %}
  <p>{{ paragraph }}</p>
  {%- endfor %}
  <dl class="field-list student-project__fields">
    <div><dt>Research Area</dt><dd><a href="/research/#{{ project.area.slug }}">{{ project.area.title }}</a></dd></div>
    <div><dt>{{ "Supervisors" if project.supervisors.length > 1 else "Supervisor" }}</dt><dd>
      {%- for person in project.supervisors -%}
      {%- if person.profile and person.profile != onProfile -%}
      <a href="/people/{{ person.profile }}/">{{ person.name }}</a>
      {%- else -%}
      {{ person.name }}
      {%- endif -%}
      {%- if not loop.last %}, {% endif -%}
      {%- endfor -%}
    </dd></div>
    {%- if project.students.length %}
    <div><dt>{{ "Students" if project.students.length > 1 else "Student" }}</dt><dd>{{ project.students | join(", ") }}</dd></div>
    {%- endif %}
  </dl>
  {%- if project.links.length %}
  <ul class="link-list">
    {%- for link in project.links %}
    {#- Named with the title, so a screen reader's list of links tells one "Report" from the next. #}
    <li><a href="{{ link.url }}" aria-label="{{ link.label }}: {{ project.title }}">{{ link.label }}</a></li>
    {%- endfor %}
  </ul>
  {%- endif %}
</article>
{%- endmacro -%}
